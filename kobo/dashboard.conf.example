# Réglages du tableau de bord sur la Kobo.
# Copiez ce fichier en « dashboard.conf », dans le même dossier que kobo_fetch.sh, puis adaptez-le.
# C'est un fichier de variables shell : pas d'espaces autour du « = ».

# Adresse de l'image sur le Raspberry Pi
DASH_URL=http://192.168.1.135/dashboard.png

# Secondes entre deux rafraîchissements : 900 = 15 minutes (le rythme du Raspberry Pi),
# 300 = 5 minutes (pour tester)
DASH_INTERVAL=900

# Nombre de tours avant que la boucle s'arrête (et que le lanceur redémarre la Kobo).
# 0 = sans fin. Mettez 3 ou 4 pour vos premiers essais avec le lanceur : la Kobo revient
# toute seule à la normale.
DASH_MAX_LOOPS=0

# Pourcentage de batterie de la Kobo, dessiné par-dessus l'image en haut à droite
# (1 = oui, 0 = non). Le serveur laisse ce coin blanc dans tous les cas.
DASH_BATTERY=1

# Réglages fins, seulement si le texte n'est pas bien placé ou trop petit/grand :
# taille (multiple de la police de base : 2 = lettres de 16 px) et décalage en pixels
# (X > 0 vers la droite, Y > 0 vers le bas). Pour essayer sans retélécharger l'image :
#   sh kobo_fetch.sh battery
DASH_BATTERY_SIZE=2
DASH_BATTERY_X=0
DASH_BATTERY_Y=17
